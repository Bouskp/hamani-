---
import "../styles/postComponent.css"
import {categories, formaterDateLong, getDate} from "../utils/getCategories.js"
const {item} = Astro.props

const image = item["yoast_head_json"]["og_image"][0].url

---

<article class="post-card">
 <a href=`/articles/${item.slug}`>
  <div class="img">
    <img src={image} alt="post image">
  </div>
 <div class="post-content">
  <div class="indications">
    <span class="date">{getDate(new Date(item.date_gmt))}</span>
    <span class=`taxynomie ${categories[item.categories[0]]}`>{categories[item.categories[0]]}</span>
   </div>
  <h3>{item.yoast_head_json.title.replace("- Hamanie", "")}</h3>
  <p set:html={item.excerpt.rendered.trim()} />
  
  </div>
</a>
</article>