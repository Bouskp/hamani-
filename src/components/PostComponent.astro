---
import "../styles/postComponent.css"
import {categories, formaterDateLong} from "../utils/getCategories.js"
const {item} = Astro.props

const image = item["yoast_head_json"]["og_image"][0].url

---

<article class="post-card">
 <a href=`/articles/${item.slug}`>
  <img src={image} alt="post image">
 <div class="post-content">
  <div class="indications">
   <p class="date">{formaterDateLong(new Date(item.date_gmt))}</p>
   <p class=`taxynomie ${categories[item.categories[0]]}`>{categories[item.categories[0]]}</p>

  </div>
   <h3>{item.yoast_head_json.title}</p>
 </div>
</a>
</article>