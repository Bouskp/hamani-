---
const pdfUrl = "/magazine.pdf";
---

<section class="magazine-reader">

  <h1>Mian Magazine</h1>

  <div id="flipbook"></div>

  <div class="controls">
    <button id="prev">⬅</button>
    <button id="next">➡</button>
  </div>

</section>

<!-- Scripts -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.6.347/pdf.min.js" integrity="sha512-Z8CqofpIcnJN80feS2uccz+pXWgZzeKxDsDNMD/dJ6997/LSRY+W4NmEt9acwR+Gt9OHN0kkI1CTianCwoqcjQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script 
  src="https://code.jquery.com/jquery-3.7.1.min.js"
  integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
  crossorigin="anonymous"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/turn.js/3/turn.min.js" integrity="sha512-rFun1mEMg3sNDcSjeGP35cLIycsS+og/QtN6WWnoSviHU9ykMLNQp7D1uuG1AzTV2w0VmyFVpszi2QJwiVW6oQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>


<script>
  const url = "/MianMagazine.pdf";

  function initFlipbook() {
  const isMobile = window.innerWidth < 768;

  $("#flipbook").turn({
    width: isMobile ? window.innerWidth : 900,
    height: isMobile ? window.innerHeight * 1.3 : 700,
    autoCenter: true,
    display: isMobile ? "single" : "double"
  });
}

  pdfjsLib.getDocument(url).promise.then(pdf => {

    for (let i = 1; i <= pdf.numPages; i++) {

      pdf.getPage(i).then(page => {

        const canvas = document.createElement("canvas");
        const context = canvas.getContext("2d", {
          willReadFrequently:true
        });

        const viewport = page.getViewport({ scale: 2 });

        canvas.width = viewport.width;
        canvas.height = viewport.height;

        page.render({
          canvasContext: context,
          viewport: viewport
        });

        const div = document.createElement("div");
        div.classList.add("page");
        div.appendChild(canvas);

        document.getElementById("flipbook").appendChild(div);

        if (i === pdf.numPages) {
         initFlipbook()
        }

      });

    }

  });

  // navigation
  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("next").onclick = () => {
      $("#flipbook").turn("next");
    };

    document.getElementById("prev").onclick = () => {
      $("#flipbook").turn("previous");
    };
  });

  window.addEventListener("resize", () => {
  $("#flipbook").turn("destroy");
  initFlipbook();
});
</script>

<style>
.magazine-reader{
  text-align:center;
  padding:40px;
  background:#0f172a;
  color:white;
  position:relative
}

#flipbook{
  max-width:100%;
  height: 700px;
  margin:30px auto;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

.page{
  background:white;
  max-height: 100%;
}

.controls button{
  margin:10px;
  padding:10px 20px;
  font-size:18px;
  cursor:pointer;
  border:none;
  background:#f59e0b;
  border-radius:5px;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: min-content;  
  z-index: 100;
}

#prev {
  left: 15px;
}

#next {
  right: 15px;
}

@media(max-width:768px){
  #flipbook{
    width:100%;
    height:100%;
  }


  .controls button {
    top: auto;
    bottom: 0;
  }
  

  #prev {
  left: 30px;
}

  #next {
  right: 30px;
}
}
</style>