---
import { Image } from "astro:assets"
import logo from "../assets/images/logo.jpg"
import "../styles/navbar.css"
import { Fragment } from "astro/jsx-runtime"

---
 <div class="navbar">
  <div class="logo">
   <a href="/"><Image src={logo} alt="logo du site"/></a>
   <div class="icons">
    <span id="open">
     <i class="fa-solid fa-bars"></i>
    </span>
    <span>
     <i class="fa-solid fa-magnifying-glass"></i>
    </span>
   </div>
  </div>
  <div class="nav-list">
  <nav>
   <ul class="list">
    <li><a href="/">Accueil</a></li>
    <li><a href="/rubriques/politique">Politique</a></li>
    <li><a href="/rubriques/economie">Economie</a></li>
    <li><a href="/rubriques/societe">Société</a></li>
    <li><a href="/rubriques/culture">Culture & Style</a></li>
    <li><a href="/rubriques/sports">Sports</a></li>
    <li><a href="/magazine">Magazines</a></li>
    <li><a href="/miantv">Mian TV</a></li>
   </ul>
  </nav>
 </div>
 </div>
 
 

 <script>
  const navList = document.querySelector('.nav-list')
  const open = document.querySelector('#open')

  window.onscroll = (e)=> {
   if(window.pageYOffset > 135) {
    navList.classList.add("sticky")
   } else {
    navList.classList.remove('sticky')
   }
  }

  open.addEventListener('click', (e)=> {
   navList.classList.toggle('open')
  })
 </script>

