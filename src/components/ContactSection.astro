---
import "../styles/contactsection.css"
---

<section class="contact-section">
 <div class="container">
   <h2 class="section-title">Envoyer un message</h2>
   <p class="section-subtitle">
     Une question, un partenariat ou une demande ? Contactez-nous.
   </p>

   <div class="contact-content">

     <!-- INFOS -->
     <div class="contact-info">
       <h3>CONTACTS</h3>
       <p>Email : infos@mianmedia.com</p>
       <p>Téléphone : +225 07 14 13 25 74</p>
       <p>Abidjan, Côte d'Ivoire</p>

       <div class="socials">
         <a href="https://www.facebook.com/hamanienews/" target="_blank"><i class="fab fa-facebook-f"></i></a>
         <a href="https://www.instagram.com/hamanie.news/" target="_blank"><i class="fab fa-instagram"></i></a>
         <a href="https://www.linkedin.com/company/hamani%C3%A8?trk=public_post_feed-actor-name" target="_blank"><i class="fab fa-linkedin-in"></i></a>
         <a href="https://api.whatsapp.com/message/FJISNKRLPX74M1" target="_blank"><i class="fa-brands fa-whatsapp"></i></a>
    <a href="https://www.youtube.com/@mian_media/featured" target="_blank"><i class="fa-brands fa-youtube"></i></a>
       </div>
     </div>

     <!-- FORMULAIRE -->
     <form class="contact-form">

       <div class="form-group">
         <input type="text" placeholder="Nom complet" required>
       </div>

       <div class="form-group">
         <input type="email" placeholder="Email" required>
       </div>

       <div class="form-group">
         <input type="text" placeholder="Sujet">
       </div>

       <div class="form-group">
         <textarea placeholder="Votre message" rows="5" required></textarea>
       </div>

       <button type="submit">Envoyer</button>

     </form>

   </div>

 </div>

</section>