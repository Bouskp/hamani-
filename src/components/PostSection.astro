---
import "../styles/postSection.css"
import PostComponent from "../components/PostComponent.astro"
const datas = await fetch('https://hamanie.news/wp-json/wp/v2/posts?_embed&per_page=12')
const posts = await datas.json()


---
<section class="recent-posts">
 <div class="container">
   <h2 class="section-title">A la une</h2>
   <div class="posts-grid">
    <div class="featured-posts">
      {
        posts.map((post) => (
          <PostComponent item={post}/>
        ))
      }
    </div>
   </div>
  </div>
 </div>

</section>